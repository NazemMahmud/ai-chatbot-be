# App
APP_NAME=AI-Chatbot
APP_ENV=development
SECRET_KEY=change-me-to-a-random-string-min-32-chars
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379/0

# Storage (MinIO for local dev)
STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chatbot

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Embedding: "ollama" or "huggingface"
EMBED_PROVIDER=ollama
EMBED_MODEL_NAME=nomic-embed-text
EMBED_DIMENSIONS=768

# Chat LLM (via Ollama)
CHAT_MODEL_NAME=smollm3:3b
CHAT_TEMPERATURE=0.7

# Document Parser: "simple" or "docling"
# simple = lightweight text-only (~170MB, ~200MB RAM)
# docling = heavy, handles images/tables/OCR (~1.7GB, 3-4GB RAM)
PARSER_TYPE=simple

# Text2SQL (DB connector feature)
ENABLE_DB_CONNECTOR=false
SQL_PROVIDER=ollama
SQL_MODEL_NAME=sqlcoder:7b

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# JWT
JWT_SECRET=change-me-to-another-random-string
JWT_EXPIRY_HOURS=24
