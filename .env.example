# App
APP_NAME=AI-Chatbot
APP_ENV=development
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379/0

# Storage (MinIO for local dev)
STORAGE_TYPE=minio
STORAGE_LOCAL_PATH=./uploads

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chatbot
MINIO_SECURE=false

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=phi4
OLLAMA_TIMEOUT=300.0

# Embedding dimensions (nomic-embed-text = 768, mxbai-embed-large = 1024)
EMBED_DIMENSIONS=768

# Embedding safety limits
EMBED_MAX_INPUT_CHARS=6000
EMBED_MAX_CONCURRENT=4
EMBED_SHRINK_RETRIES=4
EMBED_MIN_RETRY_CHARS=200
EMBED_TIMEOUT=300.0

# Document upload
MAX_FILE_SIZE=5242880

# Document Parser: "simple" or "docling"
# simple = lightweight text-only (~170MB, ~200MB RAM) (pypdf, python-docx)
# docling = heavy, handles images/tables/OCR (~1.7GB, 3-4GB RAM)
DEFAULT_PARSER_TYPE=simple

# Text2SQL (DB connector feature)
ENABLE_DB_CONNECTOR=false
SQL_PROVIDER=ollama
SQL_MODEL_NAME=sqlcoder:7b

# Chunking Settings — strategy: "character" (fast) or "semantic" (smarter)
CHUNKING_STRATEGY=semantic
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Semantic chunking (only used when CHUNKING_STRATEGY=semantic)
SEMANTIC_SIMILARITY_PERCENTILE=10.0
SEMANTIC_MIN_CHUNK_SIZE=200
SEMANTIC_MAX_CHUNK_SIZE=2000
SEMANTIC_MAX_SENTENCE_CHARS=500
SEMANTIC_MAX_WINDOW_CHARS=6000

# Worker Settings
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT=3600

# LLM Chat-bot Settings (used globally, not per-bot)
LLM_SYSTEM_PROMPT=You are a helpful AI assistant. Answer questions based on the provided context.

# Separate smaller/faster model for document summary extraction.
# Uses OLLAMA_LLM_MODEL if not set.
OLLAMA_SUMMARY_MODEL=

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# JWT
JWT_SECRET=change-me-to-another-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# Telegram Bot API
TELEGRAM_BOT_TOKEN=

# Widget Rate Limiting
WIDGET_RATE_LIMIT_PER_MINUTE=20
WIDGET_RATE_LIMIT_PER_HOUR=60

# RAG Settings
VECTOR_TOP_K=50
KEYWORD_TOP_K=30
RRF_K=60

# Reranker (flashrank cross-encoder, runs after RRF merge)
RERANKER_ENABLED=true
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANKER_TOP_N=20

# Query Rewriting — LLM generates alternative search queries for multi-query retrieval
# When enabled, user queries are rewritten into multiple search queries for better recall
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_NUM_QUERIES=3

# Agentic RAG — retry retrieval when LLM can't answer from initial results
# When enabled, the system retries with LLM-suggested alternative queries on refusal
AGENTIC_RAG_ENABLED=false
AGENTIC_RAG_MAX_RETRIES=2

# Metadata Extraction — LLM extracts entities/topics from chunks during document processing
# When enabled, each chunk gets enriched metadata (entities, key_terms, topic) for better search
METADATA_EXTRACTION_ENABLED=false
